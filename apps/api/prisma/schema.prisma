generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  password           String
  name               String
  isActive           Boolean                  @default(true)
  // Set when an admin creates the account or resets the password; the user is
  // forced through a password change before they can use the app.
  mustChangePassword Boolean                  @default(false)
  lastLoginAt        DateTime?
  roleId             String
  branchId           String?
  role               Role                     @relation(fields: [roleId], references: [id])
  branch             Branch?                  @relation(fields: [branchId], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  employee           Employee?
  dsirReports        DsirReport[]
  salaryRecords      EmployeeSalary[]
  rentRecords        BranchRent[]
  schedulesCreated   WorkSchedule[]           @relation("ScheduleCreatedBy")
  schedulesApproved  WorkSchedule[]           @relation("ScheduleApprovedBy")
  branchPlansMarked  WorkScheduleBranchPlan[] @relation("BranchPlannedBy")

  @@index([roleId])
  @@index([branchId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  // System roles (super_admin) cannot be renamed, deleted, or stripped of
  // permissions through the GUI — the lock-yourself-out guard.
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?
  roles       Role[]
}

/// Which government paper a branch holds. Nearly all of these are ANNUAL and
/// renewing them is the point of tracking them — a lapsed Mayor's Permit or
/// Sanitary Permit can close a branch. OTHER carries its own label so a permit
/// nobody anticipated does not require a migration.
enum PermitType {
  MAYORS_PERMIT
  BARANGAY_CLEARANCE
  BIR_REGISTRATION
  SANITARY_PERMIT
  FIRE_SAFETY
  OCCUPANCY_PERMIT
  ZONING_CLEARANCE
  ENVIRONMENTAL
  OTHER
}

model Branch {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
  address  String?

  // ─── The lease ───────────────────────────────────────────────────────────
  /// The CURRENT lease. A branch that re-signs with a new lessor overwrites
  /// these; what must not be lost is the rent actually paid over time, which
  /// lives in BranchRent below.
  lessorName        String?
  lessorContact     String?
  lessorAddress     String?
  contractStart     DateTime? @db.Date
  contractEnd       DateTime? @db.Date
  /// Days of notice the contract requires before renewal or termination. The
  /// figure that decides when contractEnd stops being a date and starts being a
  /// deadline.
  renewalNoticeDays Int?
  /// Integer centavos, as everywhere. Typically two months of each in PH leases.
  depositCents      Int?
  advanceCents      Int?
  /// Slot for the scanned contract. Unused until attachments are built; keeping
  /// the column means adding them is additive rather than another migration.
  contractFile      String?

  permits              BranchPermit[]
  rents                BranchRent[]
  utilityAccounts      BranchUtilityAccount[]
  users                User[]
  employees            Employee[]
  dsirReports          DsirReport[]
  transfersIn          DsirTransfer[]
  inboundSnapshotsFrom DsirInboundSnapshot[]    @relation("DsirInboundFrom")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  /// Staff from other branches planned to work here on a given day.
  scheduledVisitors    WorkScheduleEntry[]      @relation("ScheduleAssignedBranch")
  schedulePlans        WorkScheduleBranchPlan[]
}

/// One permit held by one branch.
///
/// A table rather than columns on Branch because the set is open-ended and each
/// one carries its own number, issuer and expiry. Columns would mean a migration
/// per permit type and a row of mostly-null fields.
model BranchPermit {
  id           String     @id @default(cuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type         PermitType
  /// Required when type is OTHER, ignored otherwise.
  label        String?
  number       String?
  issuedOn     DateTime?  @db.Date
  /// The whole reason this table exists. Indexed because "what expires soon"
  /// is the query that matters.
  expiresOn    DateTime?  @db.Date
  /// Who issued it — "Davao City", "BFP Region XI", "BIR RDO 113".
  authority    String?
  note         String?
  /// Slot for the scan; see Branch.contractFile.
  documentFile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([expiresOn])
}

enum UtilityType {
  ELECTRIC
  WATER
  INTERNET
  OTHER
}

/// A utility account held by a branch — one per meter, essentially.
///
/// Separate from the bills so the account and meter numbers are stored once
/// rather than retyped onto twelve bills a year, and so a branch with two
/// electric meters is representable.
model BranchUtilityAccount {
  id            String      @id @default(cuid())
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type          UtilityType
  /// Required when type is OTHER; the display name otherwise comes from the type.
  label         String?
  /// "Davao Light", "Davao City Water District".
  provider      String?
  accountNumber String?
  meterNumber   String?
  isActive      Boolean     @default(true)

  bills BranchUtilityBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

/// One bill for one period.
///
/// A ledger, not an effective-dated figure like rent: each bill is a discrete
/// event with its own period, amount and due date, and last month's bill is not
/// superseded by this month's — both are facts.
///
/// `consumption` is optional and is the reason to bother recording more than the
/// amount: a bakery's electricity is chillers and ovens, and a month that jumps
/// without a tariff change is a failing compressor or a door left open. Water
/// behaves the same way for leaks. The unit follows the type — kWh for electric,
/// cubic metres for water — so it is not stored per row.
model BranchUtilityBill {
  id        String               @id @default(cuid())
  accountId String
  account   BranchUtilityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  amountCents Int
  dueDate     DateTime? @db.Date
  /// Null means unpaid. The due date plus this is what raises a disconnection
  /// warning, so "paid" is a date rather than a boolean — when it was settled
  /// matters as much as whether.
  paidOn      DateTime? @db.Date
  consumption Int?
  /// OR number, or the reference from an online payment.
  referenceNo String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One bill per account per period; re-entering a period corrects it.
  @@unique([accountId, periodStart])
  @@index([accountId, periodStart])
  @@index([dueDate])
}

/// The rent for a branch from a date onward.
///
/// Effective-dated for the same reason as EmployeeSalary: leases escalate,
/// usually annually, and a rise must not rewrite what last year's costs were.
/// Which figure applies is decided by date, so there is no "current" flag to
/// drift and a scheduled increase can be entered before it takes effect.
model BranchRent {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  amountCents   Int
  effectiveFrom DateTime @db.Date
  note          String?

  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  /// Re-entering a start date corrects that figure rather than rivalling it.
  @@unique([branchId, effectiveFrom])
  @@index([branchId, effectiveFrom])
}

/// How a product is sold. Affects how its price reads: ₱25 per piece vs per kilo.
enum ProductUnit {
  PIECE
  PACK
  KILO
  TRAY
  BOX
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Job role on the shop floor — distinct from Role, which governs system access.
///
/// This was a Prisma enum until 2026-09-02. It became a table because the roles
/// a bakery actually has are not knowable from here: a new branch adds a
/// "Pastry Chef" or a "Delivery Helper" and nobody should need a deploy for it.
/// The seven original values are seeded, so nothing that existed is lost.
model EmployeePosition {
  id        String     @id @default(cuid())
  name      String     @unique
  /// Kept out of pickers without breaking the employees who still hold it.
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// What an employee is planned to be doing on one day of a cutoff.
///
/// The five the branches actually use. Anything about what HAPPENED — absent,
/// half day, suspended, resigned — is deliberately NOT here: the plan and the
/// actual were the same spreadsheet before, which is why the plan could never be
/// looked back on. Actuals get their own record later.
enum WorkDayStatus {
  /// The tick. Scheduled; for the ladies the Team Leader decides opener/closer.
  SCHEDULED
  /// The X. No shift that day — not a day off, simply not rostered.
  NOT_SCHEDULED
  OFF
  /// Commissary staff sent to the bakery counter when there is nothing to cook.
  FRONTLINE
  /// The manager naming the opener directly instead of leaving it to the Team Leader.
  OPENER
}

enum WorkScheduleStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// One cutoff's plan, for every branch at once — the shape of the spreadsheet
/// this replaces.
///
/// The week runs THURSDAY to WEDNESDAY. That is the payroll cutoff, not a
/// convention worth "fixing": every figure derived from a week has to line up
/// with it.
model WorkSchedule {
  id        String             @id @default(cuid())
  /// The Thursday. Enforced in the API, and unique so one cutoff cannot be
  /// planned twice.
  weekStart DateTime           @unique @db.Date
  status    WorkScheduleStatus @default(DRAFT)
  notes     String?

  createdById  String?
  createdBy    User?     @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  /// The General Manager. One approver, not one per branch.
  approvedById String?
  approvedBy   User?     @relation("ScheduleApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  entries     WorkScheduleEntry[]
  branchPlans WorkScheduleBranchPlan[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

/// One employee, one day.
/// A branch HR has finished planning for a cutoff.
///
/// Cannot be derived from the entries. A branch where everyone genuinely works
/// all seven days looks exactly like one nobody has touched — and the whole
/// point is telling those apart before the schedule goes for approval.
model WorkScheduleBranchPlan {
  id          String       @id @default(cuid())
  scheduleId  String
  schedule    WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  plannedAt   DateTime     @default(now())
  plannedById String?
  plannedBy   User?        @relation("BranchPlannedBy", fields: [plannedById], references: [id])

  @@unique([scheduleId, branchId])
}

model WorkScheduleEntry {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   WorkSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// The calendar day, not an offset: a date is unambiguous when read back.
  day        DateTime      @db.Date
  status     WorkDayStatus @default(SCHEDULED)

  /// Set when they are planned to work somewhere other than their own branch —
  /// the TRD/Pan/Km11 cells in the spreadsheet.
  assignedBranchId String?
  assignedBranch   Branch? @relation("ScheduleAssignedBranch", fields: [assignedBranchId], references: [id])

  /// "Off/Dorilag" — off, with Dorilag covering. Only meaningful on an OFF day.
  coveredById  String?
  coveredBy    Employee? @relation("ScheduleCoveredBy", fields: [coveredById], references: [id])
  /// "w/ Dorilag" — rostered alongside someone. Only meaningful on a working day.
  pairedWithId String?
  pairedWith   Employee? @relation("SchedulePairedWith", fields: [pairedWithId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId, day])
  @@index([scheduleId, day])
}

model Product {
  id               String                @id @default(cuid())
  /// Optional short code (BRD-001). Unique when present; Postgres allows many NULLs.
  sku              String?               @unique
  name             String
  description      String?
  categoryId       String
  category         Category              @relation(fields: [categoryId], references: [id])
  /// Money is INTEGER CENTAVOS, never a float. ₱25.50 == 2550.
  priceCents       Int
  /// What it costs us. Gated behind the products:cost permission.
  costCents        Int?
  unit             ProductUnit           @default(PIECE)
  /// Filename on the products volume, e.g. "a1b2c3.webp". Not a full path.
  imageFile        String?
  isActive         Boolean               @default(true)
  sortOrder        Int                   @default(0)
  dsirLines        DsirLine[]
  dsirCharges      DsirCharge[]
  dsirTransfers    DsirTransfer[]
  inboundSnapshots DsirInboundSnapshot[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

/// Job role on the shop floor. Distinct from `Role`, which governs system access.
enum Gender {
  MALE
  FEMALE
}

/// Highest level completed. A list rather than free text so "HS grad",
/// "High School" and "Highschool" cannot become three different answers;
/// `educationDetail` carries the course or school.
enum EducationLevel {
  ELEMENTARY
  HIGH_SCHOOL
  SENIOR_HIGH
  VOCATIONAL
  COLLEGE
  POST_GRADUATE
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

/// Drives the probation alert: only PROBATIONARY has a deadline that matters.
/// Probation caps at six months under the Labor Code, and staff not acted on by
/// then become regular by operation of law — so this is a date the system has to
/// raise, not merely store.
enum EmploymentType {
  PROBATIONARY
  REGULAR
  CONTRACTUAL
  PART_TIME
}

/// Bakery staff are usually paid a daily rate; office staff monthly. Stored per
/// salary record because it can change with a promotion, and a past payslip must
/// keep the basis it was actually computed on.
enum SalaryRateType {
  DAILY
  MONTHLY
  HOURLY
}

enum PayoutMethod {
  CASH
  BANK
  EWALLET
}

/// A person who works at a branch. Most have no system login — an Employee is a
/// staff record, a User is an account. The optional link joins the few who are both.
///
/// `branchId` is the CURRENT assignment only. Staff are transferred between
/// branches (and between trading names) as needed; historical attribution comes
/// from the DSIR a charge was recorded on, which carries its own branch and date.
model Employee {
  id           String           @id @default(cuid())
  employeeCode String?          @unique
  // Stored in parts: payroll and official documents need them separately, and
  // splitting a full name back apart guesses wrong on suffixes and middle names.
  firstName    String
  middleName   String?
  lastName     String
  suffix       String?
  /// ON DELETE RESTRICT, like Product.categoryId: a position still held by
  /// somebody cannot be deleted out from under them.
  positionId   String
  position     EmployeePosition @relation(fields: [positionId], references: [id])
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  userId       String?          @unique
  user         User?            @relation(fields: [userId], references: [id])
  isActive     Boolean          @default(true)

  // ─── Personal ────────────────────────────────────────────────────────────
  /// Age is NOT stored — it is derived from birthDate, so it cannot go stale.
  birthDate       DateTime?       @db.Date
  birthPlace      String?
  gender          Gender?
  civilStatus     CivilStatus?
  religion        String?
  address         String?
  email           String?
  /// Whole centimetres. The UI shows the feet/inches equivalent beside it.
  heightCm        Int?
  /// GRAMS, so 62.5 kg is exact and there is no float in the record — the same
  /// reasoning as money being centavos. The UI works in kg.
  weightGrams     Int?
  educationLevel  EducationLevel?
  /// Course or school — "BS Hotel & Restaurant Management".
  educationDetail String?
  remarks         String?

  // ─── Paperwork on file ───────────────────────────────────────────────────
  /// Dates rather than ticks: these answer "do we have it?" and "since when?".
  /// Null means not on file. For the Authority to Deduct in particular, when it
  /// was signed is what matters if a deduction is ever disputed.
  confidentialityAgreementOn DateTime? @db.Date
  authorityToDeductOn        DateTime? @db.Date
  birthCertificateOn         DateTime? @db.Date
  marriageContractOn         DateTime? @db.Date
  /// Next of kin. Three loose fields rather than a model: this is read by a
  /// human in an emergency, never queried or joined.
  emergencyName              String?
  emergencyRelation          String?
  emergencyContact           String?

  // ─── Government IDs ──────────────────────────────────────────────────────
  /// Stored as typed, not normalised: these are transcribed from cards and IDs
  /// and the formatting (dashes, spacing) is how they appear on the filings.
  /// Not unique — a blank is common, and duplicates are a data-entry problem to
  /// surface rather than a constraint to enforce at 3am.
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?
  tin              String?

  // ─── Employment ──────────────────────────────────────────────────────────
  dateHired                DateTime?      @db.Date
  employmentType           EmploymentType @default(PROBATIONARY)
  /// When probation ends. Set explicitly rather than derived from dateHired:
  /// the actual contract date is what governs, not six months of arithmetic.
  probationEndDate         DateTime?      @db.Date
  /// Probation can be extended to give someone a further chance. The ORIGINAL
  /// end date above is kept: the record of how long they were given, and why,
  /// is the point. Warnings count down to this date when it is set.
  probationExtendedTo      DateTime?      @db.Date
  probationExtensionReason String?
  regularizedAt            DateTime?      @db.Date
  separatedAt              DateTime?      @db.Date
  separationReason         String?

  // ─── Payout ──────────────────────────────────────────────────────────────
  payoutMethod  PayoutMethod @default(CASH)
  payoutAccount String?

  contacts    EmployeeContact[]
  salaries    EmployeeSalary[]
  charges     DsirCharge[]
  collections DsirCollection[]
  openedFor   DsirReport[]      @relation("DsirOpener")
  closedFor   DsirReport[]      @relation("DsirCloser")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // ─── Work schedule ───────────────────────────────────────────────────────
  scheduleEntries WorkScheduleEntry[]
  /// Days this person is covering someone else's day off.
  coveringEntries WorkScheduleEntry[] @relation("ScheduleCoveredBy")
  /// Days someone else is rostered alongside them.
  pairedEntries   WorkScheduleEntry[] @relation("SchedulePairedWith")

  @@index([branchId])
  @@index([isActive])
  @@index([lastName, firstName])
}

/// A phone number for an employee.
///
/// A table rather than a second column because the count varies: dual-SIM is
/// normal, and which network a number is on decides who can actually reach them
/// when one has no signal. Two columns would need a third the first time someone
/// carries three, and neither could say which network.
///
/// Distinct from the emergency contact above, which stays three loose fields —
/// that is exactly one person with a fixed shape, read by a human in a hurry.
model EmployeeContact {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  number    String
  /// "Globe", "Smart", "DITO", "Home". Free text rather than an enum: networks
  /// come and go, and people label a number however they think of it.
  label     String?
  /// The order to try them in. Without it the order is whatever Postgres
  /// returns, which is undefined and shifts as rows are rewritten.
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, sortOrder])
}

/// One pay rate, valid from a date until the next record supersedes it.
///
/// A table rather than columns on Employee because a raise must not rewrite
/// history: payroll for January has to keep January's rate after a March
/// increase. This is the same rule as `unitPriceCents` snapshotted onto
/// `DsirLine` — a rate that moves retroactively silently falsifies every figure
/// already derived from it, and here those figures are people's wages.
///
/// Superseding is by date, not by a flag: "the record with the greatest
/// effectiveFrom not after the date in question". No `isCurrent` boolean to fall
/// out of sync, and a future-dated raise can be entered before it takes effect.
model EmployeeSalary {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Integer centavos, as everywhere else money is stored in this schema.
  basicCents     Int
  allowanceCents Int            @default(0)
  rateType       SalaryRateType @default(DAILY)

  effectiveFrom DateTime @db.Date
  /// Why it changed — "regularised", "annual increase", "promoted to baker".
  note          String?

  /// Who entered it. Kept for the audit trail this table exists to support.
  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  /// One rate per employee per start date; re-entering a date is a correction,
  /// which should update that record rather than quietly create a rival.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

/// DRAFT is editable; FINALIZED locks the report. Encoding runs days behind the
/// branch, so back-dated entry is normal, not an error state.
enum DsirStatus {
  DRAFT
  FINALIZED
}

/// One Daily Sales & Inventory Report: one branch, one day.
/// Sales are DERIVED from stock movement, never entered. See docs/DOMAIN.md.
model DsirReport {
  id         String     @id @default(cuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id])
  reportDate DateTime   @db.Date
  status     DsirStatus @default(DRAFT)

  /// Which optional columns this form uses. DECLARED by the encoder, never
  /// inferred from emptiness — an unticked box means "checked, there were none",
  /// not "nobody looked". A charge that is silently skipped overstates sales and
  /// surfaces as a shortage deducted from a cashier's wages.
  usesCharges   Boolean @default(false)
  usesPullOuts  Boolean @default(false)
  usesTransfers Boolean @default(false)
  usesOverEnd   Boolean @default(false)

  /// The two people who physically counted. Optional: the paper form does not
  /// always name them.
  openedById String?
  openedBy   Employee? @relation("DsirOpener", fields: [openedById], references: [id])
  closedById String?
  closedBy   Employee? @relation("DsirCloser", fields: [closedById], references: [id])

  /// Who typed it in, and when it was locked.
  encodedById String?
  encodedBy   User?     @relation(fields: [encodedById], references: [id])
  finalizedAt DateTime?
  notes       String?

  lines           DsirLine[]
  charges         DsirCharge[]
  transfers       DsirTransfer[]
  inboundSnapshot DsirInboundSnapshot[]
  collections     DsirCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, reportDate])
  @@index([reportDate])
  @@index([status])
}

/// One product's stock movement on one report.
model DsirLine {
  id        String     @id @default(cuid())
  reportId  String
  report    DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])

  /// SNAPSHOT of the price at encoding. Prices change once or twice a year; without
  /// this, a price change would silently rewrite the sales figures of every past
  /// report — and those figures drive wage deductions.
  unitPriceCents Int

  /// The order the encoder put this line in. Without it the row order is
  /// whatever Postgres returns, which is not defined and shifts as rows are
  /// rewritten — so "the order I added them in" was not recoverable at all.
  position Int @default(0)

  begBal Int @default(0)

  /// How each figure was counted, when it was counted rather than simply typed:
  /// { "endBal": "4*5+3*4" } means the 32 came from a 4x5 layer under a 3x4 one.
  ///
  /// A stack is counted layer by layer, and the arithmetic is the only record of
  /// how the encoder arrived at a number — worth keeping when a count is later
  /// questioned. Kept as JSON rather than a column per field because it is read
  /// back for display and never queried on.
  ///
  /// Cleared per field whenever that figure is typed plainly, so it can never
  /// describe a number it no longer explains.
  enteredAs Json?

  /// Whether the opening figure is the opener's own recount rather than the
  /// figure carried from the previous finalised report.
  ///
  /// While false, begBal tracks that carry: correcting a draft's predecessor
  /// flows forward, and the encoder cannot quietly adjust an opening to make a
  /// day balance. Setting it true is a deliberate act in the UI, and the gap
  /// against the carried figure is then shown rather than hidden — an opener
  /// counting fewer than the closer left is overnight loss, which docs/DOMAIN.md
  /// treats as real signal.
  begBalRecounted Boolean @default(false)

  produced  Int @default(0)
  overEnd   Int @default(0)
  pulledOut Int @default(0)
  endBal    Int @default(0)

  @@unique([reportId, productId])
  @@index([productId])
  @@index([reportId, position])
}

/// An employee mistake — dropped or burned stock — charged to them at full
/// selling price and recovered via payroll. Modelled per-record rather than as a
/// per-product number, because two people can damage the same product in a day.
/// Stock this branch RECEIVED, frozen at the moment the report was finalised.
///
/// A transfer is entered once, by the sender, and the receiver reads it — which
/// is right, because asking both branches to type the same movement is how they
/// come to disagree. But reading it LIVE means a finalised report is not
/// actually finalised: editing the sender's draft moves the receiver's available
/// stock, and therefore its derived sales and its variance. Variance is deducted
/// from a cashier's wages (docs/DOMAIN.md), so a closed report changing months
/// later is a real problem, not a display quirk.
///
/// Written at finalisation and deleted on reopen — a reopened report is being
/// revised, and should see current reality until it is closed again. Same rule
/// as `unitPriceCents` on DsirLine, for the same reason.
///
/// Product and branch stay as foreign keys: what has to be frozen is the
/// QUANTITY, since that is what the arithmetic uses. A branch being renamed does
/// not change what was received.
model DsirInboundSnapshot {
  id       String     @id @default(cuid())
  reportId String
  report   DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  fromBranchId String
  fromBranch   Branch @relation("DsirInboundFrom", fields: [fromBranchId], references: [id])

  quantity Int

  createdAt DateTime @default(now())

  @@index([reportId])
}

model DsirCharge {
  id         String     @id @default(cuid())
  reportId   String
  report     DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id])
  quantity   Int

  @@index([reportId])
  @@index([employeeId])
}

/// Stock moved to another branch. Rare, but essential when it happens.
model DsirTransfer {
  id         String     @id @default(cuid())
  reportId   String
  report     DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  toBranchId String
  toBranch   Branch     @relation(fields: [toBranchId], references: [id])
  quantity   Int

  @@index([reportId])
}

/// Cash turned in per cashier. A list, not the paper's fixed Cashier 1/2/3 slots.
model DsirCollection {
  id          String     @id @default(cuid())
  reportId    String
  report      DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id])
  label       String?
  amountCents Int

  @@index([reportId])
}
