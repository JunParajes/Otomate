generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  password           String
  name               String
  isActive           Boolean          @default(true)
  // Set when an admin creates the account or resets the password; the user is
  // forced through a password change before they can use the app.
  mustChangePassword Boolean          @default(false)
  lastLoginAt        DateTime?
  roleId             String
  branchId           String?
  role               Role             @relation(fields: [roleId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employee           Employee?
  dsirReports        DsirReport[]
  salaryRecords      EmployeeSalary[]

  @@index([roleId])
  @@index([branchId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  // System roles (super_admin) cannot be renamed, deleted, or stripped of
  // permissions through the GUI — the lock-yourself-out guard.
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?
  roles       Role[]
}

model Branch {
  id          String         @id @default(cuid())
  name        String         @unique
  isActive    Boolean        @default(true)
  users       User[]
  employees   Employee[]
  dsirReports DsirReport[]
  transfersIn DsirTransfer[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// How a product is sold. Affects how its price reads: ₱25 per piece vs per kilo.
enum ProductUnit {
  PIECE
  PACK
  KILO
  TRAY
  BOX
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  /// Optional short code (BRD-001). Unique when present; Postgres allows many NULLs.
  sku           String?        @unique
  name          String
  description   String?
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  /// Money is INTEGER CENTAVOS, never a float. ₱25.50 == 2550.
  priceCents    Int
  /// What it costs us. Gated behind the products:cost permission.
  costCents     Int?
  unit          ProductUnit    @default(PIECE)
  /// Filename on the products volume, e.g. "a1b2c3.webp". Not a full path.
  imageFile     String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  dsirLines     DsirLine[]
  dsirCharges   DsirCharge[]
  dsirTransfers DsirTransfer[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

/// Job role on the shop floor. Distinct from `Role`, which governs system access.
enum EmployeePosition {
  MANAGER
  BAKER
  FRONTLINER
  CASHIER
  HELPER
  DRIVER
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

/// Drives the probation alert: only PROBATIONARY has a deadline that matters.
/// Probation caps at six months under the Labor Code, and staff not acted on by
/// then become regular by operation of law — so this is a date the system has to
/// raise, not merely store.
enum EmploymentType {
  PROBATIONARY
  REGULAR
  CONTRACTUAL
  PART_TIME
}

/// Bakery staff are usually paid a daily rate; office staff monthly. Stored per
/// salary record because it can change with a promotion, and a past payslip must
/// keep the basis it was actually computed on.
enum SalaryRateType {
  DAILY
  MONTHLY
  HOURLY
}

enum PayoutMethod {
  CASH
  BANK
  EWALLET
}

/// A person who works at a branch. Most have no system login — an Employee is a
/// staff record, a User is an account. The optional link joins the few who are both.
///
/// `branchId` is the CURRENT assignment only. Staff are transferred between
/// branches (and between trading names) as needed; historical attribution comes
/// from the DSIR a charge was recorded on, which carries its own branch and date.
model Employee {
  id           String           @id @default(cuid())
  employeeCode String?          @unique
  // Stored in parts: payroll and official documents need them separately, and
  // splitting a full name back apart guesses wrong on suffixes and middle names.
  firstName    String
  middleName   String?
  lastName     String
  suffix       String?
  position     EmployeePosition @default(OTHER)
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  userId       String?          @unique
  user         User?            @relation(fields: [userId], references: [id])
  isActive     Boolean          @default(true)

  // ─── Personal ────────────────────────────────────────────────────────────
  birthDate         DateTime?    @db.Date
  civilStatus       CivilStatus?
  address           String?
  contactNumber     String?
  /// Next of kin. Three loose fields rather than a model: this is read by a
  /// human in an emergency, never queried or joined.
  emergencyName     String?
  emergencyRelation String?
  emergencyContact  String?

  // ─── Government IDs ──────────────────────────────────────────────────────
  /// Stored as typed, not normalised: these are transcribed from cards and IDs
  /// and the formatting (dashes, spacing) is how they appear on the filings.
  /// Not unique — a blank is common, and duplicates are a data-entry problem to
  /// surface rather than a constraint to enforce at 3am.
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?
  tin              String?

  // ─── Employment ──────────────────────────────────────────────────────────
  dateHired        DateTime?      @db.Date
  employmentType   EmploymentType @default(PROBATIONARY)
  /// When probation ends. Set explicitly rather than derived from dateHired:
  /// the actual contract date is what governs, not six months of arithmetic.
  probationEndDate DateTime?      @db.Date
  regularizedAt    DateTime?      @db.Date
  separatedAt      DateTime?      @db.Date
  separationReason String?

  // ─── Payout ──────────────────────────────────────────────────────────────
  payoutMethod  PayoutMethod @default(CASH)
  payoutAccount String?

  salaries    EmployeeSalary[]
  charges     DsirCharge[]
  collections DsirCollection[]
  openedFor   DsirReport[]     @relation("DsirOpener")
  closedFor   DsirReport[]     @relation("DsirCloser")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId])
  @@index([isActive])
  @@index([lastName, firstName])
}

/// One pay rate, valid from a date until the next record supersedes it.
///
/// A table rather than columns on Employee because a raise must not rewrite
/// history: payroll for January has to keep January's rate after a March
/// increase. This is the same rule as `unitPriceCents` snapshotted onto
/// `DsirLine` — a rate that moves retroactively silently falsifies every figure
/// already derived from it, and here those figures are people's wages.
///
/// Superseding is by date, not by a flag: "the record with the greatest
/// effectiveFrom not after the date in question". No `isCurrent` boolean to fall
/// out of sync, and a future-dated raise can be entered before it takes effect.
model EmployeeSalary {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Integer centavos, as everywhere else money is stored in this schema.
  basicCents     Int
  allowanceCents Int            @default(0)
  rateType       SalaryRateType @default(DAILY)

  effectiveFrom DateTime @db.Date
  /// Why it changed — "regularised", "annual increase", "promoted to baker".
  note          String?

  /// Who entered it. Kept for the audit trail this table exists to support.
  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  /// One rate per employee per start date; re-entering a date is a correction,
  /// which should update that record rather than quietly create a rival.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

/// DRAFT is editable; FINALIZED locks the report. Encoding runs days behind the
/// branch, so back-dated entry is normal, not an error state.
enum DsirStatus {
  DRAFT
  FINALIZED
}

/// One Daily Sales & Inventory Report: one branch, one day.
/// Sales are DERIVED from stock movement, never entered. See docs/DOMAIN.md.
model DsirReport {
  id         String     @id @default(cuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id])
  reportDate DateTime   @db.Date
  status     DsirStatus @default(DRAFT)

  /// Which optional columns this form uses. DECLARED by the encoder, never
  /// inferred from emptiness — an unticked box means "checked, there were none",
  /// not "nobody looked". A charge that is silently skipped overstates sales and
  /// surfaces as a shortage deducted from a cashier's wages.
  usesCharges   Boolean @default(false)
  usesPullOuts  Boolean @default(false)
  usesTransfers Boolean @default(false)
  usesOverEnd   Boolean @default(false)

  /// The two people who physically counted. Optional: the paper form does not
  /// always name them.
  openedById String?
  openedBy   Employee? @relation("DsirOpener", fields: [openedById], references: [id])
  closedById String?
  closedBy   Employee? @relation("DsirCloser", fields: [closedById], references: [id])

  /// Who typed it in, and when it was locked.
  encodedById String?
  encodedBy   User?     @relation(fields: [encodedById], references: [id])
  finalizedAt DateTime?
  notes       String?

  lines       DsirLine[]
  charges     DsirCharge[]
  transfers   DsirTransfer[]
  collections DsirCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, reportDate])
  @@index([reportDate])
  @@index([status])
}

/// One product's stock movement on one report.
model DsirLine {
  id        String     @id @default(cuid())
  reportId  String
  report    DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])

  /// SNAPSHOT of the price at encoding. Prices change once or twice a year; without
  /// this, a price change would silently rewrite the sales figures of every past
  /// report — and those figures drive wage deductions.
  unitPriceCents Int

  /// The order the encoder put this line in. Without it the row order is
  /// whatever Postgres returns, which is not defined and shifts as rows are
  /// rewritten — so "the order I added them in" was not recoverable at all.
  position Int @default(0)

  begBal Int @default(0)

  /// How each figure was counted, when it was counted rather than simply typed:
  /// { "endBal": "4*5+3*4" } means the 32 came from a 4x5 layer under a 3x4 one.
  ///
  /// A stack is counted layer by layer, and the arithmetic is the only record of
  /// how the encoder arrived at a number — worth keeping when a count is later
  /// questioned. Kept as JSON rather than a column per field because it is read
  /// back for display and never queried on.
  ///
  /// Cleared per field whenever that figure is typed plainly, so it can never
  /// describe a number it no longer explains.
  enteredAs Json?

  /// Whether the opening figure is the opener's own recount rather than the
  /// figure carried from the previous finalised report.
  ///
  /// While false, begBal tracks that carry: correcting a draft's predecessor
  /// flows forward, and the encoder cannot quietly adjust an opening to make a
  /// day balance. Setting it true is a deliberate act in the UI, and the gap
  /// against the carried figure is then shown rather than hidden — an opener
  /// counting fewer than the closer left is overnight loss, which docs/DOMAIN.md
  /// treats as real signal.
  begBalRecounted Boolean @default(false)

  produced  Int @default(0)
  overEnd   Int @default(0)
  pulledOut Int @default(0)
  endBal    Int @default(0)

  @@unique([reportId, productId])
  @@index([productId])
  @@index([reportId, position])
}

/// An employee mistake — dropped or burned stock — charged to them at full
/// selling price and recovered via payroll. Modelled per-record rather than as a
/// per-product number, because two people can damage the same product in a day.
model DsirCharge {
  id         String     @id @default(cuid())
  reportId   String
  report     DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id])
  quantity   Int

  @@index([reportId])
  @@index([employeeId])
}

/// Stock moved to another branch. Rare, but essential when it happens.
model DsirTransfer {
  id         String     @id @default(cuid())
  reportId   String
  report     DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  toBranchId String
  toBranch   Branch     @relation(fields: [toBranchId], references: [id])
  quantity   Int

  @@index([reportId])
}

/// Cash turned in per cashier. A list, not the paper's fixed Cashier 1/2/3 slots.
model DsirCollection {
  id          String     @id @default(cuid())
  reportId    String
  report      DsirReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id])
  label       String?
  amountCents Int

  @@index([reportId])
}
