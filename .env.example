# Copy to .env and fill in. NEVER commit .env.
#
# ─── QUOTE EVERY VALUE WITH SINGLE QUOTES ─────────────────────
# Not cosmetic. An unquoted value is interpreted twice over:
#
#   Docker Compose interpolates it. Measured: `pa$$w0rd$USER`
#   unquoted reaches the container as `pa$w0rdjun` — `$$` collapses
#   to `$` and `$USER` becomes the host username. DOUBLE quotes do
#   NOT prevent this; only single quotes do.
#
#   A shell that sources the file (`set -a; . ./.env`) expands it
#   again, differently. That produced a P1013 "invalid port number"
#   from Prisma once in production, which points nowhere near the
#   real cause.
#
# Single quotes make the file mean exactly what it says to both
# readers. If a value itself contains a single quote, write it as
# '\'' — close, escape, reopen.

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER='otomate'
POSTGRES_PASSWORD='changeme'
POSTGRES_DB='otomate_db'

# ─── API ──────────────────────────────────────────────────────
DATABASE_URL='postgresql://otomate:changeme@postgres:5432/otomate_db'
JWT_SECRET='replace-with-a-long-random-secret-min-32-chars'
API_PORT='3001'
# Where product images are written. Docker sets this to /app/uploads (a volume);
# leave unset when running the API outside Docker and it uses ./uploads
# UPLOAD_DIR=
NODE_ENV='development'

# ─── Web (Vite exposes VITE_* vars to the browser) ────────────
# Dev: point to local API
# Prod: point to your server IP or domain
VITE_API_URL='http://localhost:3001'

# --- Cloudflare (production only; see docs/DOMAIN-SETUP.md) ---
# Tunnel token from Zero Trust > Networks > Tunnels. Without it the app is
# LAN-only; the rest of the stack is unaffected.
# TUNNEL_TOKEN=
# Scoped API token (Zone > DNS > Edit on otomate.uk) for the DDNS updater that
# keeps server.otomate.uk pointing here, so deploys stop breaking on IP changes.
# CF_API_TOKEN=
# CF_ZONE_NAME=otomate.uk
# CF_RECORD_NAME=server.otomate.uk
